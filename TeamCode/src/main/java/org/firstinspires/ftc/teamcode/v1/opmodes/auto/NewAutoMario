package org.firstinspires.ftc.teamcode.v1.opmodes.auto;

import com.pedropathing.geometry.BezierLine;
import com.pedropathing.geometry.Pose;
import com.pedropathing.paths.PathChain;
import com.qualcomm.robotcore.eventloop.opmode.Autonomous;
import org.firstinspires.ftc.teamcode.v1.services.PreferencesService;


/**
 * NewAuto — Template for a simple state-machine autonomous.
 * Right now, this untested auto should move from lower-left corner -> upper-right corner -> upper-left corner -> lower-right corner
 * We use 3 moving states and a superfluous state (Parking) to navigate the field.
 */
@Autonomous(name = "V1 New Custom Auto", group = "Auto-v1")
public class NewAuto extends AutonomousBase {

    // 1. Define your states
    private enum State {
        DRIVE_TO_CORNER_ONE,
        DRIVE_TO_CORNER_TWO,
        DRIVE_TO_CORNER_THREE,
        PARKING,
    }

    private State currentState = State.DRIVE_TO_CORNER_ONE;
    private boolean pathStarted = false;
    private PathChain toCornerOne;
    private PathChain toCornerTwo;
    private PathChain toCornerThree;

    @Override
    protected void buildPath() {
            toCornerOne = robot.drive.pathBuilder()
                    .addPath(
                            new BezierLine(
                                    new Pose(8.500, 8.500),
                                    new Pose(116.000, 116.000)
                            )
                    )
                    .setLinearHeadingInterpolation(
                            Math.toRadians(90),
                            Math.toRadians(180)
                    )
                    .build();

            toCornerTwo = robot.drive.pathBuilder()
                    .addPath(
                            new BezierLine(
                                    new Pose(116.000, 116.000),
                                    new Pose(25.000, 116.000)
                            )
                    )
                    .setLinearHeadingInterpolation(Math.toRadians(180),Math.toRadians(315))
                    .build();

            toCornerThree = robot.drive.pathBuilder()
                    .addPath(
                            new BezierLine(
                                    new Pose(25.000, 116.000),
                                    new Pose(116.000, 20.000)
                            )
                    )
                    .setTangentHeadingInterpolation()
                    .build();
        }


    @Override
    public void runOpMode() {
        initRobot();
        buildPath();


        // Setup starting pose for the localizer
        robot.drive.setStartingPose(new Pose(8.5, 8.5, 90));

        while (!isStarted() && !isStopRequested()) {
            if (gamepad1.x) {
                setAllianceColor(PreferencesService.ALLIANCE_BLUE);
            } else if (gamepad1.b) {
                setAllianceColor(PreferencesService.ALLIANCE_RED);
            }

            telemetry.addLine("Select Alliance");
            telemetry.addData("Alliance", allianceColor);
            telemetry.addLine("Press X for BLUE; B for RED");
            telemetry.update();
        }
        waitForStart();

        while (opModeIsActive() && !isStopRequested()) {
            // ALWAYS clear bulk cache and update the drive system first
            robot.hardware.clearBulkCache();
            robot.drive.update();

            // 3. State Machine Logic
            switch (currentState) {
                case DRIVE_TO_CORNER_ONE:
                    if (!pathStarted) {
                        robot.drive.followPath(toCornerOne, true);
                        pathStarted = true;
                    }

                    if (pathStarted && !robot.drive.isFollowing()) {
                        pathStarted = false;
                        currentState = NewAuto.State.DRIVE_TO_CORNER_TWO;
                    }
                    break;

                case DRIVE_TO_CORNER_TWO:

                    if (!pathStarted) {
                        robot.drive.followPath(toCornerTwo, true);
                        pathStarted = true;
                    }
                    if (pathStarted && !robot.drive.isFollowing()) {
                        pathStarted = false;
                        currentState = State.DRIVE_TO_CORNER_THREE;
                    }
                    break;

                case DRIVE_TO_CORNER_THREE:
                    if (!pathStarted) {
                        robot.drive.followPath(toCornerThree, true);
                        pathStarted = true;
                    }
                    if (pathStarted && !robot.drive.isFollowing()) {
                        pathStarted = false;
                        currentState = State.PARKING;
                    }
                    break;

                case PARKING:
                    // stopRobot();
                    break;
            }

            // Standard Telemetry
            telemetry.addData("State", currentState);
            telemetry.addData("Pose", robot.drive.getPose());
            telemetry.update();
        }

        saveFinalState();
        stopRobot();
    }
}
